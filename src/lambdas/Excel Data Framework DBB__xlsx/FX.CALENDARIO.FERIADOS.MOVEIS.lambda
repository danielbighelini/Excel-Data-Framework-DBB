=_xlfn.LAMBDA(_xlop.Ano,_xlop.Descricao,_xlop.Colunas,_xlfn.LET(_xlpm.VetorAnos, IF(OR(_xlfn.ISOMITTED(_xlpm.Ano), _xlpm.Ano = ""), YEAR(TODAY()), _xlpm.Ano), _xlpm.n, COUNTA(_xlpm.VetorAnos), _xlpm.ColCalc, IF(_xlfn.ISOMITTED(_xlpm.Colunas), 2, _xlpm.Colunas), _xlpm.feriados, FX.CFG.FERIADOS(), _xlpm.colNome, FX.CFG.COLUNA(_xlpm.feriados, "Nome"), _xlpm.colReferencia, FX.CFG.COLUNA(_xlpm.feriados, "Referência"), _xlpm.colOffset, FX.CFG.COLUNA(_xlpm.feriados, "Offset"), _xlpm.colRegularidade, FX.CFG.COLUNA(_xlpm.feriados, "Regularidade"), _xlpm.colAtivo, FX.CFG.COLUNA(_xlpm.feriados, "Ativo"), _xlpm.Dados, _xlfn._xlws.FILTER(_xlfn.HSTACK(_xlpm.colNome, _xlpm.colReferencia, _xlpm.colOffset), (_xlpm.colAtivo) * (_xlpm.colRegularidade = "Móvel")), _xlpm._Nome, _xlfn.CHOOSECOLS(_xlpm.Dados, 1), _xlpm._Referencia, _xlfn.CHOOSECOLS(_xlpm.Dados, 2), _xlpm._Offset, _xlfn.CHOOSECOLS(_xlpm.Dados, 3), _xlpm.CalcAno, _xlfn.LAMBDA(_xlpm._Ano, _xlfn.LET(_xlpm.Datas, _xlfn.MAP(_xlpm._Referencia, _xlpm._Offset, _xlfn.LAMBDA(_xlpm.r,_xlpm.o, FX.CALENDARIO.FERIADO(_xlpm._Ano, _xlpm.r, _xlpm.o))), _xlpm.Resultado, _xlfn.HSTACK(_xlpm.Datas, _xlpm._Nome), _xlpm.Retorno, IF(OR(_xlfn.ISOMITTED(_xlpm.Descricao), _xlpm.Descricao = ""), _xlpm.Resultado, _xlfn._xlws.FILTER(_xlpm.Resultado, _xlpm._Nome = _xlpm.Descricao)), IF(_xlpm.ColCalc = 1, _xlfn.CHOOSECOLS(_xlpm.Retorno, 1), _xlpm.Retorno))), _xlpm.ResultadoInicial, _xlpm.CalcAno(INDEX(_xlpm.VetorAnos, 1)), _xlpm.ResultadoFinal, IF(_xlpm.n = 1, _xlpm.ResultadoInicial, _xlfn.REDUCE(_xlpm.ResultadoInicial, _xlfn.SEQUENCE(_xlpm.n - 1) + 1, _xlfn.LAMBDA(_xlpm.acc,_xlpm.i, _xlfn.VSTACK(_xlpm.acc, _xlpm.CalcAno(INDEX(_xlpm.VetorAnos, _xlpm.i)))))), _xlpm.ResultadoFinal))
