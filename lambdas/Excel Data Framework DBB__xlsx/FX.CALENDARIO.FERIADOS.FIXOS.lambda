Name: FX.CALENDARIO.FERIADOS.FIXOS
Scope: Workbook
Source Workbook: Excel Data Framework DBB.xlsx
Source Workbook Folder: Excel Data Framework DBB__xlsx
Description: Retorna os feriados de data fixa cadastrados para um ou mais anos, com suporte a filtros por abrangÃªncia, estado e expediente.


Formula:
=LAMBDA(Ano,Abrangencia,Estado,Expediente,Colunas,LET(vetAnos, IF(ISOMITTED(Ano), SEQUENCE(1, , YEAR(NOW())), Ano), qAnos, COUNTA(vetAnos), AbrangenciaParam, IF(ISOMITTED(Abrangencia), "", Abrangencia), estadoParam, IF(ISOMITTED(Estado), "", Estado), expedienteParam, IF(ISOMITTED(Expediente), "", Expediente), colParam, IF(ISOMITTED(Colunas), 2, Colunas), colMes, tbParametrosFeriados[Mês], colDia, tbParametrosFeriados[Dia], colNome, tbParametrosFeriados[Nome], colAbrangencia, tbParametrosFeriados[Abrangência], colRegularidade, tbParametrosFeriados[Regularidade], colAtivo, tbParametrosFeriados[Ativo], colVigenciaInicial, tbParametrosFeriados[VigênciaInicial], colEstado, tbParametrosFeriados[Estado], colExpediente, tbParametrosFeriados[Expediente], calcAno, LAMBDA(_ano, LET(anoCalc, IF(OR(_ano = "", ISOMITTED(_ano)), YEAR(NOW()), _ano), datas, DATE(anoCalc, colMes, colDia), matriz, HSTACK(datas, colNome), mask, ((colRegularidade = "Fixo") * (colAtivo) * (colVigenciaInicial < DATE(anoCalc, 12, 31)) * IF(AbrangenciaParam <> "", (colAbrangencia = AbrangenciaParam), 1) * IF(estadoParam <> "", (colEstado = estadoParam), 1) * IF(expedienteParam <> "", (colExpediente = expedienteParam), 1)), selecionadosTemp, IFERROR(FILTER(matriz, mask, ""), ""), selecionados, IF(selecionadosTemp = "", IF(colParam = 2, {"";""}, {""}), UNIQUE(selecionadosTemp)), selecionados)), inicial, calcAno(INDEX(vetAnos, 1)), resultado, IF(qAnos = 1, inicial, REDUCE(inicial, SEQUENCE(qAnos - 1) + 1, LAMBDA(acc,idx, VSTACK(acc, calcAno(INDEX(vetAnos, idx)))))), saída, IF(colParam = 2, resultado, INDEX(resultado, 0, 1)), UNIQUE(saída)))

