=LAMBDA(Ano,Descricao,Colunas,LET(VetorAnos, SE(OU(ISOMITTED(Ano), Ano = ""), ANO(HOJE()), Ano), n, CONT.VALORES(VetorAnos), ColCalc, SE(ISOMITTED(Colunas), 2, Colunas), Dados, FILTRO(EMPILHARH(tbParametrosFeriados[Nome], tbParametrosFeriados[Referência], tbParametrosFeriados[Offset]), (tbParametrosFeriados[Regularidade] = "Móvel") * (tbParametrosFeriados[Ativo] = VERDADEIRO)), Nomes, ÍNDICE(Dados, , 1), Referencias, ÍNDICE(Dados, , 2), Offsets, ÍNDICE(Dados, , 3), CalcAno, LAMBDA(_Ano, LET(Datas, MAP(Referencias, Offsets, LAMBDA(r,o, FX.CALENDARIO.FERIADO(_Ano, r, o))), Resultado, EMPILHARH(Datas, Nomes), Retorno, SE(OU(ISOMITTED(Descricao), Descricao = ""), Resultado, FILTRO(Resultado, Nomes = Descricao)), SE(ColCalc = 1, ESCOLHERCOLS(Retorno, 1), Retorno))), ResultadoInicial, CalcAno(ÍNDICE(VetorAnos, 1)), ResultadoFinal, SE(n = 1, ResultadoInicial, REDUCE(ResultadoInicial, SEQUÊNCIA(n - 1) + 1, LAMBDA(acc,i, EMPILHARV(acc, CalcAno(ÍNDICE(VetorAnos, i)))))), ResultadoFinal))

