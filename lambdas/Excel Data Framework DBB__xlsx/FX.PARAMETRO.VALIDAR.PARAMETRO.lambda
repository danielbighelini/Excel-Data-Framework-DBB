Raw Formula Snapshot (en-US) - Preview Only:
=_xlfn.LAMBDA(_xlpm.parametro,_xlpm.tipo,_xlpm.obrigatorio,_xlpm.valor,_xlpm.permitidos,_xlpm.parametros,_xlfn.LET(_xlpm._Parametro, TRIM(_xlpm.parametro & ""), _xlpm._Definido, FX.PARAMETRO.DEFINIDO(_xlpm.parametro, _xlpm.tipo, _xlpm.obrigatorio, _xlpm.valor, _xlpm.permitidos), IF(NOT(_xlpm._Definido), "", IF(_xlpm._Parametro = "", "✖ Parâmetro não informado.", IF(COUNTIF(_xlpm.parametros, _xlpm._Parametro) > 1, "✖ Parâmetro duplicado.", "")))))
