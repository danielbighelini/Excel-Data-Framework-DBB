Formula:
=LAMBDA(parametro,tipo,obrigatorio,valor,permitidos,parametros,IF(NOT(FX.PARAMETRO.DEFINIDO(parametro, tipo, obrigatorio, valor, permitidos)), "", LET(_Mensagens, VSTACK(FX.PARAMETRO.VALIDAR.PARAMETRO(parametro, tipo, obrigatorio, valor, permitidos, parametros), FX.PARAMETRO.VALIDAR.VALOR(parametro, tipo, obrigatorio, valor, permitidos), FX.PARAMETRO.VALIDAR.OBRIGATORIO(parametro, tipo, obrigatorio, valor, permitidos), FX.PARAMETRO.VALIDAR.PERMITIDOS(parametro, tipo, obrigatorio, valor, permitidos)), _resultado, IFERROR(TEXTJOIN("; ", TRUE, FILTER(_Mensagens, _Mensagens <> "")), "✔"), _resultado)))

