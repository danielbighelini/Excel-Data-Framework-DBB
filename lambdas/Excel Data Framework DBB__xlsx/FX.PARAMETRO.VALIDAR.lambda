=LAMBDA(parametro,tipo,obrigatorio,valor,permitidos,parametros,SE(NÃO(FX.PARAMETRO.DEFINIDO(parametro, tipo, obrigatorio, valor, permitidos)), "", LET(_Mensagens, EMPILHARV(FX.PARAMETRO.VALIDAR.PARAMETRO(parametro, tipo, obrigatorio, valor, permitidos, parametros), FX.PARAMETRO.VALIDAR.VALOR(parametro, tipo, obrigatorio, valor, permitidos), FX.PARAMETRO.VALIDAR.OBRIGATORIO(parametro, tipo, obrigatorio, valor, permitidos), FX.PARAMETRO.VALIDAR.PERMITIDOS(parametro, tipo, obrigatorio, valor, permitidos)), _resultado, SEERRO(UNIRTEXTO("; ", VERDADEIRO, FILTRO(_Mensagens, _Mensagens <> "")), "✔"), _resultado)))

